# Job source: SerpApi Google Jobs (preferred). OpenWebNinja is used only if SERPAPI_API_KEY is empty.
SERPAPI_API_KEY=your_serpapi_api_key_here
OPENWEBNINJA_API_KEY=
THAILLM_API_KEY=your_thaillm_api_key_here
THAILLM_BASE_URL=https://thaillm.or.th/api/v1
THAILLM_MODEL=typhoon-s-thaillm-8b-instruct

# Timetable picture reading: OCR (ocr-service/, OpenThai2.0-OCR-Text) -> DeepSeek turns the text into class times.
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
OCR_SERVICE_URL=http://127.0.0.1:8765
# Optional shared secret; set the same value as OCR_TOKEN when starting ocr-service/server.py
OCR_SERVICE_TOKEN=
